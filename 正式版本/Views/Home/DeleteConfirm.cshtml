@model WebApplication1.Models.Student;
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>删除确认页面</title>
    <style>
        /* 页面整体样式 */
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f4f7f6;
            margin: 0;
            padding: 0;
            height: 100vh;
        }

        /* 容器样式 */
        .container {
            width: 100%;
            height: 100%;
            padding: 20px;
            display: block;
        }

        /* 表单容器 */
        .form-container {
            width: 600px;
            margin: 0 auto;
            padding: 20px;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

        /* 标题 */
        h1 {
            text-align: center;
            color: #333;
            font-size: 2rem;
            padding-bottom: 20px;
        }

        /* 表单项布局 */
        .form-group {
            margin-bottom: 15px;
        }

            .form-group label {
                display: block;
                font-size: 1rem;
                font-weight: bold;
                color: #333;
            }

        /* 提交按钮 */
        button[type="submit"] {
            width: 100%;
            padding: 12px;
            background-color: #4CAF50;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 1rem;
            margin-top: 15px;
        }

            button[type="submit"]:hover {
                background-color: #45a049;
            }

        .readonly-input {
            background-color: #f0f0f0;
            color: #999;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="form-container">
            <h1>删除确认页面</h1>
            <h4>本当に削除しますか？この操作は元に戻せません。</h4>
            <form asp-action="Delete" asp-controller="Home" method="post">
                <div class="form-group">
                    <label>学号：@Model.StudentID</label>
                </div>
                <div class="form-group">
                    <label>姓名：@Model.Name</label>
                </div>
                <div class="form-group">
                    <label>性别：@Model.Gender</label>
                </div>
                <div class="form-group">
                    <label>年龄：@Model.Age</label>
                </div>
                <div class="form-group">
                    <label>年级：@Model.Grade</label>
                </div>
                <div class="form-group">
                    <label>专业：@Model.Major</label>
                </div>
                <div class="form-group">
                    <label>省份：@Model.Province</label>
                </div>
                <button type="submit" formaction="@Url.Action("Delete", "Home", new { id = Model.StudentID })">确认删除</button>
            </form>
        </div>
    </div>
</body>
</html>
